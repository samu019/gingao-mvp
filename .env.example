# ============================================================
# Gingao environment example
# ============================================================

# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------

GINGAO_MODE=development

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

GINGAO_ALLOWED_HOSTS=
GINGAO_CSRF_TRUSTED_ORIGINS=

GINGAO_SECURE_SSL_REDIRECT=1
GINGAO_HSTS_SECONDS=3600
GINGAO_HSTS_INCLUDE_SUBDOMAINS=0
GINGAO_HSTS_PRELOAD=0

GINGAO_LOG_LEVEL=INFO


# ------------------------------------------------------------
# PostgreSQL
# Required when GINGAO_MODE=production
# ------------------------------------------------------------

DATABASE_URL=postgresql://gingao:gingao@localhost:5432/gingao
GINGAO_DB_CONN_MAX_AGE=60


# ------------------------------------------------------------
# Redis / Celery
# Required when GINGAO_MODE=production
# ------------------------------------------------------------

REDIS_URL=redis://localhost:6379/0


# ------------------------------------------------------------
# Generated-file rollout
#
# legacy  = static/generated compatibility mode
# storage = Django default_storage
#
# Production should use storage.
# ------------------------------------------------------------

GINGAO_GENERATED_STORAGE_MODE=legacy


# ------------------------------------------------------------
# Django media storage
#
# development:
#     filesystem
#
# production:
#     s3
# ------------------------------------------------------------

GINGAO_STORAGE_BACKEND=filesystem

# Required when GINGAO_STORAGE_BACKEND=s3
GINGAO_S3_BUCKET_NAME=
GINGAO_S3_ACCESS_KEY_ID=
GINGAO_S3_SECRET_ACCESS_KEY=

# Optional S3-compatible settings
GINGAO_S3_REGION_NAME=
GINGAO_S3_ENDPOINT_URL=
GINGAO_S3_CUSTOM_DOMAIN=


# ------------------------------------------------------------
# AI providers
# Keep mock while developing.
# ------------------------------------------------------------

GINGAO_IMAGE_PROVIDER=mock
GINGAO_VIDEO_PROVIDER=mock
GINGAO_AUDIO_PROVIDER=mock

# FAL
FAL_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=


# ------------------------------------------------------------
# Real-provider safety / rollout
# ------------------------------------------------------------

GINGAO_ALLOW_REAL_IMAGE_BULK=0
GINGAO_ALLOW_REAL_VIDEO_BULK=0


# NOWPayments
# Never commit real secrets.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_BASE_URL=https://api.nowpayments.io/v1
NOWPAYMENTS_USDT_CURRENCY=usdttrc20
NOWPAYMENTS_TIMEOUT_SECONDS=20


# Public HTTPS origin used for payment callbacks/returns
GINGAO_PUBLIC_BASE_URL=
